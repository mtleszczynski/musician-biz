# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID where the bot listens for messages
# Right-click the channel in Discord -> Copy Channel ID (enable Developer Mode in settings first)
CHANNEL_ID=your_channel_id_here

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-3-flash-preview)
# Options: gemini-3-flash-preview (fast+cheap), gemini-3-pro-preview (most capable)
GEMINI_MODEL=gemini-3-flash-preview

# Google Spreadsheet ID (from the sheet URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account credentials
# Option A: Path to the credentials JSON file (for local dev)
# GOOGLE_CREDENTIALS_JSON=credentials.json
# Option B: The full JSON string (for Fly.io / cloud deployment)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Confidence threshold for auto-confirmation (0.0 to 1.0, default 0.8)
CONFIDENCE_THRESHOLD=0.8

# SQLite database path (default: ./bot.db locally, /data/bot.db on Fly.io)
# DB_PATH=/data/bot.db
